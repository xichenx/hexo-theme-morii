extends includes/layout.pug

block content
  .wrap.listing-page
    .page-intro
      span.section-kicker YOUR READING LIST
      h1 稍后阅读
      p 收好感兴趣的文章，留给下一次阅读。
    section.reading-list-page(data-reading-list data-index=url_for('/morii-search.json'))
      .reading-list-intro.panel
        div
          h2 浏览器里的小书签
          p 收藏保存在当前浏览器，清理网站数据会移除记录，最多可保存 100 篇。
        a.text-link(href=url_for('/archives/')) 去找些文章 →
      p#reading-list-status(role='status' aria-live='polite') 正在读取收藏…
      button.button.service-button#reading-list-retry(type='button' hidden) 重新加载文章信息
      .reading-list-grid#reading-list-items(aria-busy='false')
      .empty-panel.panel#reading-list-empty(hidden)
        span.empty-panel__icon(aria-hidden='true') ☆
        h2 还没有收藏文章
        p 在文章标题下点击“加入稍后阅读”，下次可以从这里继续。
        a.button.button--primary(href=url_for('/archives/')) 浏览文章 →
      noscript
        p 收藏清单需要 JavaScript 来读取当前浏览器中的记录。
