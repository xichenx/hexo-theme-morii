- var globalMusic = morii_music()
#morii-audio-hub(data-music-config=JSON.stringify(globalMusic) data-music-page=url_for('/music/'))
  audio#music-player(preload='none' aria-label=morii_t("音乐播放器"))
  .music-float(hidden aria-label=morii_t("悬浮音乐播放器"))
    .music-capsule
      span.music-capsule-progress(aria-hidden='true')
      button.music-ball(type='button' data-music-action='toggle' aria-label=morii_t("播放音乐"))
        img.music-ball-cover(alt='' hidden)
        span.music-ball-note(aria-hidden='true') ♫
        span.music-ball-state(aria-hidden='true') ▶
      button.music-float-track(type='button' aria-expanded='false' aria-controls='music-capsule-lyrics' title=morii_t("点击歌名展开或收起歌词"))
        span(data-music-title) #{morii_t("未选择音乐")}
      p#music-capsule-lyrics(data-music-mini-lyric aria-hidden='true') #{morii_t("让音乐陪你继续探索。")}
      .music-float-actions
        button(type='button' data-music-action='previous' aria-label=morii_t("上一首")) ⏮
        button(type='button' data-music-action='next' aria-label=morii_t("下一首")) ⏭
        a(href=url_for('/music/') aria-label=morii_t("打开音乐馆") title=morii_t("打开完整音乐馆")) ♫
      button.music-float-resume(type='button' data-music-action='toggle') #{morii_t("播放音乐")}
    p.sr-only(data-music-status role='status')
