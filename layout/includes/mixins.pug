mixin postCard(post, featured, eager)
  - var postUrl = url_for(post.path)
  article.post-card(class=featured ? 'post-card--featured' : '')
    a.post-card__media(href=postUrl aria-label=post.title data-cover-frame=post.cover ? '' : null)
      if post.cover
        - var cover = morii_cover(post.cover, post)
        img(src=cover.src srcset=cover.srcset sizes=cover.sizes width=cover.width height=cover.height alt=post.title loading=eager ? 'eager' : 'lazy' fetchpriority=eager ? 'high' : 'low' decoding='async')
      else
        span.post-card__placeholder ✦
    .post-card__body
      .post-card__meta
        span= date(post.date, 'YYYY.MM.DD')
        if post.categories && post.categories.length
          span.post-card__dot ·
          span= post.categories.toArray()[0].name
      h3
        a(href=postUrl)= post.title
      p= morii_excerpt(post, featured ? 108 : 82)
      a.post-card__read(href=postUrl) #{morii_t("阅读文章")} #[span →]
