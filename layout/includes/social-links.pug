- var socialLinks = morii_social_links()
if socialLinks.length
  nav.social-links(aria-label=morii_t("关注作者"))
    each social in socialLinks
      .social-entry
        if social.url
          a.social-link(href=social.url target='_blank' rel='noopener noreferrer me' title=social.description aria-label=social.description class='social-link--' + social.icon)
            span.social-link__badge(aria-hidden='true')
              if social.icon === 'csdn'
                img.social-brand-image(src=url_for('/icons/social/csdn.ico') alt='' width='18' height='18')
              else if social.icon !== 'custom'
                span.social-brand-icon
              else
                = social.badge
            span= social.name
        if social.qrcode
          button.social-link(type='button' data-social-qr=url_for(social.qrcode) data-social-name=social.name data-social-account=social.account data-social-description=social.description aria-label=morii_t("扫码关注") + social.name class='social-link--' + social.icon)
            if !social.url
              span.social-link__badge(aria-hidden='true')
                if social.icon === 'csdn'
                  img.social-brand-image(src=url_for('/icons/social/csdn.ico') alt='' width='18' height='18')
                else if social.icon !== 'custom'
                  span.social-brand-icon
                else
                  = social.badge
            span= social.url ? morii_t("扫码") : social.name
