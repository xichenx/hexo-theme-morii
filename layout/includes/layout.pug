doctype html
- var visualEffects = morii_effects()
- var articleEnhancements = morii_enhancements(page)
html(lang=morii_locale() style=morii_accent() data-motion=(!theme.motion || theme.motion.enable !== false) ? 'on' : 'off' data-glass=visualEffects.enabled ? (visualEffects.glass ? 'on' : 'off') : null data-effects=visualEffects.enabled ? 'on' : null data-theme-transition=visualEffects.transition ? 'on' : null)
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    meta(name='theme-color' content=theme.accent)
    - var documentTitle = morii_page_title(page)
    - var documentDescription = is_post() ? morii_excerpt(page, 160) : page.description || config.description
    - var canonicalUrl = full_url_for((page.path || '').replace(/index\.html$/, ''))
    meta(name='description' content=documentDescription)
    title= is_home() && (!page.current || page.current === 1) ? config.title : documentTitle + ' · ' + config.title
    link(rel='canonical' href=canonicalUrl)
    meta(property='og:title' content=documentTitle)
    meta(property='og:description' content=documentDescription)
    meta(property='og:site_name' content=config.title)
    meta(property='og:type' content=is_post() ? 'article' : 'website')
    meta(property='og:url' content=canonicalUrl)
    - var shareImage = morii_share_image(page)
    if shareImage
      meta(property='og:image' content=shareImage)
    meta(name='twitter:card' content=shareImage ? 'summary_large_image' : 'summary')
    meta(name='twitter:title' content=documentTitle)
    meta(name='twitter:description' content=documentDescription)
    if shareImage
      meta(name='twitter:image' content=shareImage)
    if morii_structured_data(page)
      script(type='application/ld+json')!= morii_structured_data(page)
    if is_post()
      meta(property='article:published_time' content=date_xml(page.date))
      meta(property='article:modified_time' content=date_xml(page.updated || page.date))
    link(rel='icon' href=url_for(theme.favicon || config.favicon || '/favicon.ico'))
    script(src=morii_asset('/js/theme-init.js') data-diagnostics=theme.performance && theme.performance.diagnostics ? 'on' : null data-diagnostics-src=morii_asset('/js/diagnostics.js'))
    link(rel='stylesheet' href=morii_asset('/css/style.css'))
    link(rel='stylesheet' href=morii_asset('/css/media.css'))
    link(rel='stylesheet' href=morii_asset('/css/search.css') media='print' data-deferred-style)
    if visualEffects.enabled
      link(rel='stylesheet' href=morii_asset('/css/effects.css'))
    if !theme.motion || theme.motion.enable !== false
      link(rel='stylesheet' href=morii_asset('/css/motion.css') media='print' data-deferred-style)
    if is_archive()
      link(rel='stylesheet' href=morii_asset('/css/archive.css'))
    if page.type === 'categories' || is_category()
      link(rel='stylesheet' href=morii_asset('/css/categories.css'))
    if is_home() && (!page.current || page.current === 1) && morii_github_calendar()
      link(rel='stylesheet' href=morii_asset('/css/github-calendar.css'))
    if page.type === 'link'
      link(rel='stylesheet' href=morii_asset('/css/friends.css'))
    if page.type === 'music'
      link(rel='stylesheet' href=morii_asset('/css/music.css'))
    else
      link(rel='stylesheet' href=morii_asset('/css/music.css') media='print' data-deferred-style)
    if page.type === 'cinema'
      link(rel='stylesheet' href=morii_asset('/css/cinema.css'))
    if is_post()
      link(rel='stylesheet' href=morii_asset('/css/reading.css'))
    if is_post() && (!theme.article || !theme.article.print || theme.article.print.enable !== false)
      link#article-print-style(rel='stylesheet' href=morii_asset('/css/print.css') media='print')
  body(data-page-loading=morii_t('正在打开页面…') class=page.type === 'music' ? 'is-music' : is_post() ? 'is-reading' : page.path && page.path.startsWith('air-conditioner/') ? 'is-playground' : '')
    if visualEffects.enabled
      .morii-atmosphere(aria-hidden='true' data-aurora=visualEffects.aurora ? 'on' : null)
        if visualEffects.particles
          canvas#morii-particles(data-density=visualEffects.density)
    a.skip-link(href='#main') #{morii_t("跳转到正文")}
    include print-toolbar.pug
    .site-shell
      header.site-header
        .site-header__inner
          a.brand(href=url_for('/') aria-label=morii_t("返回首页"))
            span.brand__mark(class=theme.logo ? 'brand__mark--image' : '' aria-hidden='true')
              if theme.logo
                img(src=url_for(theme.logo) alt='' width='38' height='38')
              else
                | ✦
            span.brand__copy
              strong.brand__text= theme.brand || config.title
              if theme.tagline
                small.brand__tagline= theme.tagline
          nav.site-nav#site-nav(aria-label=morii_t("主导航"))
            each item in theme.menu
              - var activeMenu = is_current(item.path) || (item.path === '/' && is_home()) || (item.path === '/archives/' && (is_archive() || is_post())) || (item.path === '/album/' && page.type === 'album_detail')
              a(href=url_for(item.path) class=activeMenu ? 'site-nav__item--active' : '' aria-current=activeMenu ? 'page' : false)= morii_nav_label(item.name)
          .header-actions
            if !theme.quick_navigation || theme.quick_navigation.enable !== false
              button.icon-button#navigation-open(type='button' aria-label=morii_t("全站快捷导航") title=morii_t("全站快捷导航（?）") aria-haspopup='dialog' aria-controls='navigation-dialog' aria-expanded='false')
                svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' aria-hidden='true')
                  rect(x='3' y='3' width='7' height='7' rx='1.5')
                  rect(x='14' y='3' width='7' height='7' rx='1.5')
                  rect(x='3' y='14' width='7' height='7' rx='1.5')
                  rect(x='14' y='14' width='7' height='7' rx='1.5')
            button.icon-button.header-search#search-open(type='button' aria-label=morii_t("搜索文章") title=morii_t("搜索文章（⌘/Ctrl + K）"))
              svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' aria-hidden='true')
                circle(cx='10.8' cy='10.8' r='6.8')
                path(d='m16 16 4.5 4.5')
              span.header-search__label #{morii_t("搜索")}
            button.icon-button#theme-toggle(type='button' aria-label=morii_t("切换深色模式") title=morii_t("切换深色模式"))
              svg.theme-icon--moon(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' aria-hidden='true')
                path(d='M20.4 15.6A8.5 8.5 0 0 1 8.4 3.6 8.5 8.5 0 1 0 20.4 15.6Z')
              svg.theme-icon--sun(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' aria-hidden='true')
                circle(cx='12' cy='12' r='4')
                path(d='M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4')
            button.icon-button#menu-toggle.mobile-only(type='button' aria-label=morii_t("打开菜单") aria-controls='site-nav' aria-expanded='false')
              svg.menu-icon--open(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' aria-hidden='true')
                path(d='M4 7h16M4 12h16M4 17h16')
              svg.menu-icon--close(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' aria-hidden='true')
                path(d='M5 5l14 14M19 5 5 19')
        if is_post()
          .reading-progress(role='progressbar' aria-label=morii_t("阅读进度") aria-valuemin='0' aria-valuemax='100' aria-valuenow='0')
            .reading-progress__bar
      main#main
        block content
      footer.site-footer
        .footer-top
          div
            strong= theme.brand || config.title
            p= theme.tagline
          a(href=url_for('/archives/')) #{morii_t("继续探索")} #[span →]
        .footer-bottom
          span © #{new Date().getFullYear()} #{config.author}
          if theme.explore && theme.explore.length
            nav.footer-explore(aria-label=morii_t("更多探索"))
              each item in theme.explore
                a(href=url_for(item.path))= morii_nav_label(item.name)
              if !theme.reading_list || theme.reading_list.enable !== false
                a(href=url_for('/reading-list/')) #{morii_t("稍后阅读")}
          span #{morii_t("用 Hexo 与 Morii Theme 构建")}
        - var footerRuntime = morii_runtime()
        if footerRuntime || morii_filings().length
          .footer-meta
            if footerRuntime
              p.footer-runtime(data-site-start=footerRuntime.start)
                span= footerRuntime.label
                span(data-runtime-value)= footerRuntime.value
                span.footer-runtime__heart(aria-hidden='true') ♥
            include footer-filing.pug
    include navigation-panel.pug
    include social-dialog.pug
    if is_post()
      button.reading-toc-trigger(type='button' data-reading-toc aria-haspopup='dialog' aria-controls='reading-toc-dialog' hidden) #{morii_t("目录")} #[span(data-reading-percent aria-hidden='true') 0%]
      dialog.reading-toc-dialog#reading-toc-dialog(aria-labelledby='reading-toc-title')
        .reading-toc-heading
          h2#reading-toc-title #{morii_t("本文目录")}
          button.icon-button#reading-toc-close(type='button' aria-label=morii_t("关闭文章目录")) ×
        nav(aria-label=morii_t("文章章节"))
          include toc.pug
    if is_post() && (!theme.article || !theme.article.share || theme.article.share.enable !== false)
      include article-share.pug
    include search-panel.pug
    dialog.lightbox#image-dialog(aria-label=morii_t("图片预览"))
      .lightbox-header
        strong #{morii_t("图片预览")}
        button.icon-button#image-close(type='button' aria-label=morii_t("关闭图片预览")) ×
      figure
        .lightbox-stage#image-stage(tabindex='0' role='group' aria-label=morii_t("图片查看区域") aria-describedby='image-help')
          img#image-preview(alt='' draggable='false')
          .lightbox-feedback#image-feedback(hidden)
            span.lightbox-feedback-icon(aria-hidden='true')
              svg(viewBox='0 0 32 32' fill='none' stroke='currentColor' stroke-width='1.5')
                rect(x='4' y='5' width='24' height='22' rx='5')
                circle(cx='12' cy='12' r='2')
                path(d='m5 23 7-7 5 5 4-4 6 6')
            strong#image-state-title #{morii_t("正在加载图片")}
            p#image-status(role='status' aria-live='polite')
            button.button.service-button#image-retry(type='button' hidden) #{morii_t("重新加载图片")}
        figcaption#image-caption
      .lightbox-zoom(role='group' aria-label=morii_t("图片缩放"))
        button.icon-button#image-zoom-out(type='button' aria-label=morii_t("缩小图片") title=morii_t("缩小（−）")) −
        output#image-scale(aria-label=morii_t("当前缩放倍数")) 1.0×
        button.icon-button#image-zoom-in(type='button' aria-label=morii_t("放大图片") title=morii_t("放大（+）")) +
        button.button.service-button#image-reset(type='button' title=morii_t("重置缩放（0）")) #{morii_t("适应窗口")}
      p.lightbox-help#image-help #{morii_t("滚轮 / 双指缩放 · 放大后拖拽 · 左右滑动切图 · Esc 关闭")}
      .lightbox-controls
        button.icon-button#image-previous(type='button' aria-label=morii_t("上一张图片")) ←
        span#image-counter(aria-live='polite')
        button.icon-button#image-next(type='button' aria-label=morii_t("下一张图片")) →
        a.text-link#image-original(target='_blank' rel='noopener noreferrer') #{morii_t("打开原图 ↗")}
    button.icon-button.back-to-top#back-to-top(type='button' aria-label=morii_t("返回顶部") hidden) ↑
    .sr-only#theme-announcement(role='status' aria-live='polite')
    include music-hub.pug
    if morii_locale_asset()
      script(src=url_for(morii_locale_asset()) defer)
    script(src=morii_asset('/js/i18n.js') defer)
    script(src=morii_asset('/js/theme.js') defer)
    script(src=morii_asset('/js/music.js') defer)
    if page.type === 'cinema'
      script(src=morii_asset('/js/cinema.js') defer)
    if visualEffects.enabled
      script(src=morii_asset('/js/effects.js') defer data-spotlight=visualEffects.spotlight ? 'on' : 'off' data-tilt=visualEffects.tilt ? 'on' : 'off' data-ripple=visualEffects.ripple ? 'on' : 'off')
    if !theme.motion || theme.motion.enable !== false
      script(src=morii_asset('/js/motion.js') defer)
    if morii_runtime()
      script(src=morii_asset('/js/runtime.js') defer)
    if !theme.quick_navigation || theme.quick_navigation.enable !== false
      script(src=morii_asset('/js/navigation.js') defer)
    script(src=morii_asset('/js/media.js') defer)
    if morii_social_links().some(function(item) { return item.qrcode })
      script(src=morii_asset('/js/social.js') defer)
    if morii_clock().enable && (is_home() || is_archive() || is_category() || is_tag() || is_post())
      script(src=morii_asset('/js/clock.js') defer)
    if (is_post() || page.type === 'reading_list') && (!theme.reading_list || theme.reading_list.enable !== false)
      script(src=morii_asset('/js/reading-list.js') defer)
    if is_home() && (!page.current || page.current === 1)
      script(src=morii_asset('/js/discovery.js') defer)
      if morii_github_calendar()
        script(src=morii_asset('/js/github-calendar.js') defer)
    if page.type === 'link'
      script(src=morii_asset('/js/directory.js') defer)
    if page.path && page.path.startsWith('air-conditioner/')
      script(src=morii_asset('/js/air-conditioner.js') defer)
    if is_post()
      script(src=morii_asset('/js/reading.js') defer)
      if !page.password && (!theme.article || !theme.article.resume || theme.article.resume.enable !== false)
        script(src=morii_asset('/js/reading-resume.js') defer)
      if !theme.article || !theme.article.share || theme.article.share.enable !== false
        script(src=morii_asset('/js/share.js') defer)
      if !theme.article || !theme.article.print || theme.article.print.enable !== false
        script(src=morii_asset('/js/print.js') defer)
      if !theme.article || theme.article.reading_settings !== false
        script(src=morii_asset('/js/reading-preferences.js') defer)
    if is_post() && (articleEnhancements.mermaid || articleEnhancements.math)
      script(src=morii_asset('/js/article-enhancements.js') defer data-mermaid=articleEnhancements.mermaid ? url_for(articleEnhancements.mermaidURL) : null data-math=articleEnhancements.math ? url_for(articleEnhancements.mathURL) : null data-math-css=articleEnhancements.math ? url_for(articleEnhancements.mathCSS) : null)
    if morii_comments().recent || page.type === 'fcircle' || (!is_home() && !is_archive() && !is_category() && !is_tag() && page.type !== '404' && page.type !== 'categories' && page.type !== 'tags' && theme.comments && theme.comments.enable && ['twikoo', 'waline'].includes(theme.comments.provider) && page.comments !== false)
      script(src=morii_asset('/js/services.js') defer)
