if !theme.quick_navigation || theme.quick_navigation.enable !== false
  dialog.navigation-dialog#navigation-dialog(aria-labelledby='navigation-heading')
    .navigation-dialog__header
      div
        span.section-kicker EXPLORE MORII
        h2#navigation-heading #{morii_t("去哪里逛逛")}
        p #{morii_t("技术笔记、生活片段，还有一点小乐趣。")}
      button.icon-button#navigation-close(type='button' aria-label=morii_t("关闭快捷导航")) ×
    section.navigation-tools(aria-label=morii_t("阅读中控台"))
      .navigation-tool-actions
        button(type='button' data-control='theme-toggle' aria-pressed='false') #{morii_t("深色模式")}
        if is_post()
          if !theme.article || theme.article.reading_settings !== false
            button(type='button' data-control='reading-font-smaller') A−
            output(data-control-font) 17 px
            button(type='button' data-control='reading-font-larger') A＋
            button(type='button' data-control='reading-focus-toggle' aria-pressed='false') #{morii_t("专注阅读")}
          if !theme.reading_list || theme.reading_list.enable !== false
            button(type='button' data-control-bookmark) #{morii_t("收藏本文")}
      .navigation-tool-music
        button(type='button' data-control-music disabled) #{morii_t("播放音乐")}
        span(data-control-track) #{morii_t("未选择音乐")}
    nav.navigation-grid(aria-label=morii_t("全站快捷导航"))
      each item in morii_navigation()
        a.navigation-card(href=url_for(item.path))
          - var iconName = morii_icon(item.icon)
          span.navigation-card__icon(class=iconName ? 'ui-icon ui-icon--' + iconName : '' aria-hidden='true')
            if !iconName
              = item.icon
          div
            strong= item.name
            small= item.description
    .navigation-shortcuts
      button.navigation-search(type='button' data-open-search) #{morii_t("搜索文章")} #[kbd ⌘ / Ctrl + K]
      p #[kbd ?] #{morii_t("打开快捷导航 ·")} #[kbd Esc] #{morii_t("关闭弹窗")}
