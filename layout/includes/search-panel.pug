dialog.search-dialog#search-dialog(aria-labelledby='search-heading' data-search-engine=morii_asset('/js/search-engine.js') data-search-worker=(!theme.search || theme.search.worker !== false) ? morii_asset('/js/search-worker.js') : null data-search-script=morii_asset('/js/search.js') data-search-index=url_for(morii_search_index()) data-page-size=(theme.search && theme.search.page_size) || 10)
  .search-header
    .search-dialog__top
      div
        span.section-kicker SEARCH MORII
        h2#search-heading #{morii_t("发现字里行间")}
      button.icon-button#search-close(type='button' aria-label=morii_t("关闭搜索") title=morii_t("关闭（Esc）")) ×
    label.sr-only(for='search-input') #{morii_t("搜索关键词")}
    .search-input-row
      span.search-input-icon(aria-hidden='true')
        svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8')
          circle(cx='10.8' cy='10.8' r='6.8')
          path(d='m16 16 4.5 4.5')
      input#search-input(type='search' placeholder=morii_t("搜索标题、正文、分类或标签…") autocomplete='off' maxlength='200' aria-controls='search-results' aria-describedby='search-keyboard-help')
      button#search-clear(type='button' aria-label=morii_t("清空搜索关键词") hidden) #{morii_t("清空")}
    .search-scope(role='group' aria-label=morii_t("搜索范围"))
      button(type='button' data-search-scope='all' aria-pressed='true') #{morii_t("全部内容")}
      button(type='button' data-search-scope='title' aria-pressed='false') #{morii_t("仅标题")}
      button(type='button' data-search-scope='topics' aria-pressed='false') #{morii_t("分类与标签")}
    label.search-category(for='search-category')
      span #{morii_t("按分类筛选")}
      select#search-category
        option(value='') #{morii_t("全部分类")}
        each category in site.categories.toArray()
          option(value=category.name)= category.name
    if site.tags.length
      .search-suggestions(aria-label=morii_t("快速查找"))
        span #{morii_t("快速查找")}
        each tag in site.tags.sort('length', -1).limit(5).toArray()
          button(type='button' data-search-term=tag.name)= '# ' + tag.name
  .search-scroll
    .search-results-heading
      strong#search-results-heading #{morii_t("最近文章")}
      p#search-status(role='status' aria-live='polite') #{morii_t("共 {0} 篇文章", site.posts.length)}
    .search-empty(hidden)
      span.search-empty-icon(aria-hidden='true') ⌕
      strong #{morii_t("没有找到相关文章")}
      p #{morii_t("换个关键词，或切换到“全部内容”试试。")}
    ul#search-results(aria-labelledby='search-results-heading')
      each post in site.posts.sort('date', -1).limit(20).toArray()
        li(data-categories=JSON.stringify(post.password ? [] : post.categories.toArray().map(item => item.name)) data-search=morii_search_text(post) data-topics=post.password ? '' : Array.from(new Set(post.categories.toArray().concat(post.tags.toArray()).map(item => item.name))).join(' ') data-protected=post.password ? 'true' : 'false')
          a(href=url_for(post.path))
            span.search-result-icon(aria-hidden='true') ≡
            .search-result-content
              strong.search-result-title= post.title
              p.search-result-summary= morii_excerpt(post, 150)
              small= date(post.date, 'YYYY.MM.DD')
            span.search-result-arrow(aria-hidden='true') ↗
    button.button.service-button#search-more(type='button' hidden) #{morii_t("展示更多结果")}
  .search-footer
    .search-service
      p#search-service-status(role='status' aria-live='polite') #{morii_t("多个关键词用空格分隔")}
      button#search-retry(type='button' hidden) #{morii_t("重试")}
    p#search-keyboard-help
      span #[kbd ↑] #[kbd ↓] #{morii_t("选择")}
      span #[kbd Enter] #{morii_t("打开")}
      span #[kbd Esc] #{morii_t("关闭")}
