if morii_social_links().some(function(item) { return item.qrcode })
  dialog.social-dialog#social-dialog(aria-labelledby='social-dialog-heading')
    button.icon-button#social-dialog-close(type='button' aria-label=morii_t("关闭关注二维码")) ×
    span.section-kicker STAY CONNECTED
    h2#social-dialog-heading #{morii_t("扫码关注")}
    p#social-dialog-description
    .social-qr-frame
      img#social-qr-image(alt=morii_t("关注二维码"))
    p#social-qr-status(role='status' aria-live='polite')
    p#social-qr-account
    a.text-link#social-qr-original(target='_blank' rel='noopener noreferrer') #{morii_t("打开二维码原图 ↗")}
