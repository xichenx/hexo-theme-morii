dialog.article-share-dialog#article-share-dialog(aria-labelledby='article-share-heading')
  .article-share-top
    h2#article-share-heading #{morii_t("分享这篇文章")}
    button.icon-button#article-share-close(type='button' aria-label=morii_t("关闭文章分享")) ×
  p.article-share-title#article-share-title
  label(for='article-share-content') #{morii_t("复制内容")}
  textarea#article-share-content(rows='3' readonly spellcheck='false')
  .article-share-actions
    button.button.service-button#article-share-copy(type='button') #{morii_t("复制链接")}
    button.button.service-button#article-share-markdown(type='button') #{morii_t("复制 Markdown")}
    button.button.service-button#article-share-native(type='button' hidden) #{morii_t("系统分享 ↗")}
  p.article-share-status#article-share-status(role='status' aria-live='polite')
