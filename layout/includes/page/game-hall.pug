.arcade(data-arcade)
  h1 #{morii_t("游戏厅")}
  nav.arcade-picker(aria-label=morii_t("选择游戏") hidden)
    each game in [{id:'trail', icon:'✦', name:'星轨接力', kind:'路线解谜'}, {id:'garden', icon:'✿', name:'相位花园', kind:'花格解谜'}, {id:'firefly', icon:'⚡', name:'萤火冲刺', kind:'20 秒挑战'}]
      button.arcade-choice(type='button' data-game=game.id aria-pressed=game.id === 'trail' ? 'true' : 'false')
        span.arcade-choice__icon(aria-hidden='true')= game.icon
        span
          strong= morii_t(game.name)
          small= morii_t(game.kind)
  .arcade-stage(data-game-stage hidden)
    .arcade-stage__copy
      h2#arcade-title
      p#arcade-rules
      .arcade-score(data-score)
      progress.arcade-timer(data-timer max='20' value='20' aria-label=morii_t("剩余时间") hidden)
      p.arcade-status(data-status role='status')
      .arcade-actions
        button.arcade-play(type='button' data-reset)
        button.arcade-undo(type='button' data-undo) #{morii_t("撤销一步")}
        button.arcade-undo(type='button' data-pause hidden)
    .arcade-board(data-board role='group' aria-labelledby='arcade-title' aria-describedby='arcade-rules')
  noscript
    p #{morii_t("开启 JavaScript 即可在这里游玩。")}
