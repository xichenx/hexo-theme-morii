mixin cinemaPoster(film, eager)
  .cinema-poster
    if film.cover
      img(src=url_for(film.cover) alt='' width='240' height='360' loading=eager ? 'eager' : 'lazy' fetchpriority=eager ? 'high' : 'low' decoding='async')
    else
      span.cinema-poster-mark(aria-hidden='true')= film.type === 'series' ? '◇' : film.type === 'anime' ? '✧' : '✦'

mixin cinemaMeta(film)
  .cinema-meta
    span= film.type === 'series' ? morii_t("电视剧") : film.type === 'anime' ? morii_t("动漫") : morii_t("电影")
    if film.year
      span= film.year
    if film.rating
      span= morii_t("评分 {0}/10", film.rating)

mixin cinemaWatch(film)
  button.cinema-watch(type='button' data-cinema-watch=film.watchKey aria-label=morii_t("想看：{0}", film.title) aria-pressed='false' hidden)
    span(aria-hidden='true')

mixin cinemaEpisodes(film)
  each episode in film.episodes
    span(data-cinema-episode data-kind=episode.kind data-url=url_for(episode.url) data-title=episode.title data-watch-url=episode.watchUrl)
