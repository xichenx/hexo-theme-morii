include cinema-parts.pug
include cinema-player.pug
- var films = morii_cinema_catalog()
- var categories = [{key:'all', name:morii_t("全部"), count:films.length}, {key:'movie', name:morii_t("电影"), count:films.filter(function(film) { return film.type === 'movie' }).length}, {key:'series', name:morii_t("电视剧"), count:films.filter(function(film) { return film.type === 'series' }).length}, {key:'anime', name:morii_t("动漫"), count:films.filter(function(film) { return film.type === 'anime' }).length}]
.cinema(data-cinema=url_for('/cinema/'))
  if films.length
    +cinemaPlayer(morii_t("返回片单"))
    - var featured = films.find(function(film) { return film.featured }) || films[0]
    section.cinema-feature
      +cinemaPoster(featured, true)
      .cinema-feature-copy
        p.cinema-feature-label= morii_t("站长推荐")
        h2= featured.title
        +cinemaMeta(featured)
        if featured.review || featured.description
          p.cinema-feature-review= featured.review || featured.description
        a.cinema-feature-link(href=url_for('/' + featured.path)) #{morii_t("看推荐与详情")} #[span.cinema-arrow(aria-hidden='true')]
    section.cinema-recent(data-cinema-recent hidden aria-labelledby='cinema-recent-title')
      .cinema-recent-heading
        h2#cinema-recent-title= morii_t("最近观看")
        button(type='button' data-cinema-clear-history)= morii_t("清空记录")
      ul.cinema-recent-list(data-cinema-history)
    .cinema-library
      .cinema-library-heading
        h2 #{morii_t("片单")} #[small #{films.length} #{morii_t("部作品")}]
      .cinema-toolbar
        .cinema-filters(role='group' aria-label=morii_t("作品分类"))
          each category in categories
            button.cinema-filter(type='button' data-cinema-filter=category.key aria-pressed=category.key === 'all' ? 'true' : 'false') #{category.name} #[span= category.count]
          button.cinema-filter(type='button' data-cinema-filter='watchlist' aria-pressed='false' hidden) #{morii_t("想看")} #[span(data-cinema-watch-count) 0]
        label.cinema-search
          span.sr-only #{morii_t("搜索片名")}
          svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' aria-hidden='true')
            circle(cx='10.8' cy='10.8' r='6.8')
            path(d='m16 16 4.5 4.5')
          input(type='search' data-cinema-search placeholder=morii_t("搜索作品") autocomplete='off')
      .cinema-list(data-cinema-grid)
        each film in films
          article.cinema-card(data-cinema-card data-type=film.type data-title=film.title data-description=film.description)
            a.cinema-card-link(href=url_for('/' + film.path))
              +cinemaPoster(film, false)
              .cinema-card-copy
                strong.cinema-card-title= film.title
                +cinemaMeta(film)
            +cinemaWatch(film)
            if film.episodes.length
              button.cinema-quick(type='button' data-cinema-select aria-label=morii_t("查看 ") + film.title + morii_t(" 的片源") aria-pressed='false' hidden)= morii_t("查看片源")
              .cinema-card-data(hidden)
                +cinemaEpisodes(film)
      p.cinema-empty(data-cinema-no-results hidden) #{morii_t("没有找到符合条件的作品，试试别的关键词。")}
  else
    .cinema-empty.panel
      strong #{morii_t("放映表还空着")}
      p #{morii_t("在博客的 source/_data/cinema.yml 中添加作品与播放地址，就可以开始放映。")}
  p.cinema-note #{morii_t("片源由站点维护者提供。播放效果取决于视频格式、片源服务及浏览器支持。")}
