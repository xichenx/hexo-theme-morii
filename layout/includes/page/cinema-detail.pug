include cinema-parts.pug
include cinema-player.pug

- var film = page.cinemaItem
.cinema(data-cinema=url_for('/cinema/'))
  a.cinema-return(href=url_for('/cinema/'))= morii_t("← 返回片单")
  article.cinema-detail(data-cinema-detail data-type=film.type data-title=film.title data-description=film.description)
    +cinemaPoster(film, true)
    .cinema-detail-heading
      h2= film.title
      +cinemaMeta(film)
    .cinema-detail-copy
      if film.review
        .cinema-detail-section
          h3= morii_t("为什么推荐")
          p= film.review
      .cinema-detail-actions
        if film.watch.length
          each link in film.watch
            a.button.button--primary(href=url_for(link.url) target='_blank' rel='noopener noreferrer') #{link.label} #[span(aria-hidden='true') ↗]
        +cinemaWatch(film)
      if film.trailer || film.episodes.length
        .cinema-detail-actions
          if film.trailer
            button.cinema-quick(type='button' data-cinema-trailer data-kind=film.trailer.kind data-url=url_for(film.trailer.url) data-title=film.trailer.title data-watch-url=film.trailer.watchUrl hidden) #{morii_t("播放预告片")}
            noscript
              a(href=url_for(film.trailer.watchUrl || film.trailer.url))= morii_t("播放预告片")
          if film.episodes.length
            button.cinema-quick(type='button' data-cinema-select aria-pressed='false' hidden) #{morii_t("查看片源  →")}
            .cinema-card-data(hidden)
              +cinemaEpisodes(film)
      if film.description
        .cinema-detail-section
          h3= morii_t("作品简介")
          p= film.description
  if film.episodes.length || film.trailer
    +cinemaPlayer(morii_t("关闭播放器"))
