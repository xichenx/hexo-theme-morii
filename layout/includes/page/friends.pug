section.feed-section(data-feed-endpoint=morii_safe_url(theme.friends_feed && theme.friends_feed.endpoint) data-page-size=(theme.friends_feed && theme.friends_feed.page_size) || 12)
  .section-heading
    div
      span.section-kicker FRIENDS JOURNAL
      h2 #{morii_t("朋友们的最新文章")}
    a.text-link(href=url_for('/link/')) #{morii_t("友人帐 →")}
  p.feed-status(role='status' aria-live='polite') #{morii_t("正在寻找朋友们的新鲜事…")}
  .feed-grid(aria-busy='true')
  .feed-actions
    button.button.service-button#feed-more(type='button' hidden) #{morii_t("加载更多")}
    button.button.service-button#feed-retry(type='button' hidden) #{morii_t("重新加载")}
  noscript
    p #{morii_t("开启 JavaScript 后可以查看最新文章，或直接浏览下方友链。")}
section.data-section
  .section-heading
    div
      span.section-kicker ALWAYS CONNECTED
      h2 #{morii_t("去朋友家坐坐")}
  .friend-grid
    - var seenFriends = new Set()
    each group in site.data.link || []
      each friend in group.link_list || []
        - var friendUrl = morii_safe_url(friend.link)
        if friendUrl && !seenFriends.has(friendUrl)
          - seenFriends.add(friendUrl)
          a.friend-card(href=friendUrl target='_blank' rel='noopener noreferrer')
            if friend.avatar
              img(src=friend.avatar alt='' loading='lazy')
            .friend-card__text
              strong= friend.name
              small= friend.descr || morii_t("去看看他们的博客")
            span ↗
