- var friendGroups = morii_friend_groups(site.data.link)
.friends-layout
 .friend-directory
  if friendGroups.length
    .directory-toolbar.panel
      label(for='friend-search') 找一位朋友
      .friend-search-row
        input#friend-search(type='search' placeholder='搜索站名、简介、标签或域名…' autocomplete='off')
        button#friend-clear(type='button' hidden) 清空
      .directory-filters(aria-label='友链分组')
        button(type='button' data-friend-group='all' aria-pressed='true') 全部 #[span=friendGroups.reduce(function(total, group) { return total + group.friends.length }, 0)]
        each group in friendGroups
          button(type='button' data-friend-group=group.id aria-pressed='false') #{group.title} #[span=group.friends.length]
      p#friend-search-status(role='status' aria-live='polite') 共 #{friendGroups.reduce(function(total, group) { return total + group.friends.length }, 0)} 个链接
    each group in friendGroups
      section.data-section.friend-group(id=group.id data-friend-section=group.id)
        .section-heading
          div
            span.section-kicker FRIENDS
            h2 #{group.title} #[small.friend-group-count=group.friends.length]
          if group.description
            p= group.description
        .friend-grid
          each friend in group.friends
            a.friend-card(href=friend.url target='_blank' rel='noopener noreferrer' data-friend-search=(friend.name + ' ' + friend.description + ' ' + friend.domain + ' ' + friend.tag).toLowerCase())
              .friend-card-cover(data-image-fallback)
                span.friend-cover-mark(aria-hidden='true') ✦
                if friend.screenshot
                  img(src=url_for(friend.screenshot) alt='' loading='lazy')
                .friend-card-badges
                  if friend.recommend
                    span 常逛的小站
                  if friend.tag
                    span= friend.tag
              .friend-card-main
                .friend-avatar(data-image-fallback)
                  span(aria-hidden='true')= friend.name.slice(0, 1)
                  if friend.avatar
                    img(src=url_for(friend.avatar) alt='' loading='lazy')
                .friend-card__text
                  strong= friend.name
                  small= friend.description || '去看看他们的博客'
              .friend-card-bottom
                span= friend.domain
                span 去串门 ↗
    .empty-panel.panel#friend-empty(hidden)
      h2 没找到这位朋友
      p 试试其他关键词，或切换到全部分组。
      button.button.service-button#friend-reset(type='button') 查看全部友链
  else
    .empty-panel.panel
      h2 友人帐正在整理中
      p 期待在这里遇见更多有趣的朋友。
 aside.friends-connect#friend-connect(aria-label='交换友链')
  section.site-card.panel
    span.section-kicker MY LITTLE CORNER
    h2 带走本站名片
    .friend-site-preview
      img(src=theme.avatar alt='' loading='lazy')
      strong= config.title
      p= config.description
    button.button.button--primary#copy-site-card(type='button') 复制本站信息
    details.site-card__data
      summary 查看名片数据
      label.sr-only(for='site-link-data') 本站友链信息
      textarea#site-link-data(readonly rows='7' spellcheck='false')= morii_site_card()
    p#site-card-status(role='status' aria-live='polite')
  section.friend-invitation.panel
    span.section-kicker SAY HELLO
    h2 很高兴认识你
    p 如果你也喜欢记录和分享，欢迎交换友链。
    ol
      li 复制本站名片，添加到你的小站。
      li 留下站名、链接、简介和头像地址。
    a.text-link(href=url_for('/comments/')) 去留言板打个招呼 →
