extends includes/layout.pug
include includes/mixins.pug

block content
  - var directoryTopics = morii_category_directory(site.categories)
  - var hierarchy = morii_category_hierarchy(directoryTopics, page)
  if morii_layout('category') === 'cards'
    .wrap.listing-page
      .page-intro
        if hierarchy.ancestors.length
          include includes/category-breadcrumb.pug
        h1= morii_page_title(page)
        p #{morii_t("这个主题下的所有文章。")}
      .content-grid
        section.posts-column
          include includes/category-nav.pug
          include includes/category-children.pug
          if page.posts && page.posts.length
            .post-grid
              each post, index in page.posts.toArray()
                +postCard(post, false, index < 2)
          else
            p.empty-state #{morii_t("这里还没有文章。")}
          include includes/pagination.pug
        include includes/sidebar.pug
  else
    include includes/page/category-list.pug
