extends includes/layout.pug

block content
  - var articleCover = page.top_img === false ? null : page.top_img || page.cover
  - var heroCover = articleCover ? morii_cover(articleCover, page, 'hero') : null
  header.article-header.post-hero(class=articleCover ? 'has-cover' : '' data-cover-frame=articleCover ? '' : null style=heroCover && heroCover.color && (!theme.images || theme.images.cover_tone !== false) ? '--cover-tone:' + heroCover.color : null)
    if articleCover
      img.article-cover(src=heroCover.src srcset=heroCover.srcset sizes=heroCover.sizes width=heroCover.width height=heroCover.height alt='' aria-hidden='true' fetchpriority='high' decoding='async')
    .post-hero-inner
      nav.article-breadcrumb(aria-label=morii_t('面包屑导航'))
        a(href=url_for('/')) #{morii_t('首页')}
        span(aria-hidden='true') /
        a(href=url_for('/archives/')) #{morii_t('文章')}
        - var breadcrumbSeries = morii_series(page)
        if breadcrumbSeries
          span(aria-hidden='true') /
          a(href=url_for(breadcrumbSeries.path))= breadcrumbSeries.title
        span(aria-hidden='true') /
        span(aria-current='page')= page.title
      .article-kicker
        a.article-type(href=url_for('/archives/')) #{morii_t("文章")}
        if page.categories && page.categories.length
          each category in page.categories.toArray()
            a(href=url_for(category.path))= category.name
        if page.tags && page.tags.length
          each tag in page.tags.toArray().slice(0, 3)
            a.article-hero-tag(href=url_for(tag.path)) # #{tag.name}
      h1= page.title
      if page.description && !page.password
        p.article-description= page.description
      .article-meta
        span #{morii_t("发布于")} #[time(datetime=date_xml(page.date))=date(page.date, 'YYYY-MM-DD')]
        span #{morii_t("更新于")} #[time(datetime=date_xml(page.updated || page.date))=date(page.updated || page.date, 'YYYY-MM-DD')]
        if morii_reading_time(page)
          span= morii_reading_time(page)
  .wrap.reading-layout
    article.article-card
      .article-toolbar
        if !theme.reading_list || theme.reading_list.enable !== false
          .article-save-tools
            button.reading-preference-button(type='button' data-save-post=url_for(page.path) aria-pressed='false' hidden) #{morii_t("加入稍后阅读 ☆")}
            a.text-link(href=url_for('/reading-list/')) #{morii_t("查看清单 →")}
          p#reading-list-message(role='status' aria-live='polite')
        include includes/reading-settings.pug
      if !page.password && (!theme.article || !theme.article.resume || theme.article.resume.enable !== false)
        .reading-resume#reading-resume(data-updated=date_xml(page.updated || page.date) hidden)
          .reading-resume__copy
            strong #{morii_t("继续上次阅读")}
            p#reading-resume-description
          .reading-resume__actions
            button.reading-preference-button#reading-resume-continue(type='button') #{morii_t("继续阅读 →")}
            button.reading-preference-button#reading-resume-clear(type='button') #{morii_t("清除本篇记录")}
      include includes/article-series.pug
      include includes/outdated-notice.pug
      details.mobile-toc
        summary #{morii_t("本文目录")}
        include includes/toc.pug
      - var codeStyle = morii_code_style(page)
      .article-body(data-code-style=codeStyle.style data-code-theme=codeStyle.theme data-code-collapse=(!theme.article || !theme.article.code || theme.article.code.collapse !== false) ? 'true' : 'false' data-code-lines=(theme.article && theme.article.code && theme.article.code.lines) || 18)!= page.content
      if page.tags && page.tags.length
        .article-tags
          each tag in page.tags.toArray()
            a(href=url_for(tag.path)) # #{tag.name}
      .article-end
        span ✦
        p #{morii_t("感谢读到这里")}
      .article-tools
        if !theme.article || !theme.article.share || theme.article.share.enable !== false
          button.button.service-button(type='button' data-share-article aria-haspopup='dialog' aria-controls='article-share-dialog' hidden) #{morii_t("分享文章 ↗")}
        button.button.service-button#copy-article-link(type='button') #{morii_t("复制文章链接 ↗")}
        if !theme.article || !theme.article.print || theme.article.print.enable !== false
          button.button.service-button(type='button' data-preview-print hidden) #{morii_t("打印 / 导出 PDF")}
      if !theme.article || !theme.article.print || theme.article.print.enable !== false
        .print-source
          p #{config.title} · #{config.author}
          p #{morii_t("原文：")}#[a(href=full_url_for((page.path || '').replace(/index\.html$/, '')))=full_url_for((page.path || '').replace(/index\.html$/, ''))]
      include includes/series-navigation.pug
      include includes/article-discovery.pug
      include includes/comments.pug
    aside.reading-aside
      include includes/profile-card.pug
      .reading-aside-sticky
        .side-card.toc-card
          .reading-toc-heading
            h2 #{morii_t("本文目录")}
            span(data-reading-percent aria-hidden='true') 0%
          nav(aria-label=morii_t("文章章节"))
            include includes/toc.pug
        include includes/clock.pug
