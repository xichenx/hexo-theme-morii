extends includes/layout.pug

block content
  - var articleCover = page.top_img === false ? null : page.top_img || page.cover
  - var heroCover = articleCover ? morii_cover(articleCover, page, 'hero') : null
  header.article-header.post-hero(class=articleCover ? 'has-cover' : '' data-header-backdrop=articleCover ? 'inverse' : 'surface' data-cover-frame=articleCover ? '' : null style=heroCover && heroCover.color && (!theme.images || theme.images.cover_tone !== false) ? '--cover-tone:' + heroCover.color : null)
    if articleCover
      img.article-cover(src=heroCover.src srcset=heroCover.srcset sizes=heroCover.sizes width=heroCover.width height=heroCover.height alt='' aria-hidden='true' fetchpriority='high' decoding='async')
    .post-hero-inner
      nav.article-breadcrumb(aria-label=morii_t('面包屑导航'))
        a(href=url_for('/')) #{morii_t('首页')}
        span(aria-hidden='true') /
        a(href=url_for('/archives/')) #{morii_t('文章')}
        - var breadcrumbSeries = morii_series(page)
        if breadcrumbSeries
          span(aria-hidden='true') /
          a(href=url_for(breadcrumbSeries.path))= breadcrumbSeries.title
        span(aria-hidden='true') /
        span(aria-current='page')= page.title
      .article-kicker
        a.article-type(href=url_for('/archives/')) #{morii_t("文章")}
        if page.categories && page.categories.length
          each category in page.categories.toArray()
            a(href=url_for(category.path))= category.name
        if page.tags && page.tags.length
          each tag in page.tags.toArray().slice(0, 3)
            a.article-hero-tag(href=url_for(tag.path)) # #{tag.name}
      h1= page.title
      if page.description && !page.password
        p.article-description= page.description
      - var postMeta = theme.article && theme.article.meta
      - var postDateType = [page.meta_date_type, postMeta && postMeta.date_type].find(function(type) { return ['created', 'updated', 'both'].includes(type) }) || 'both'
      - var showWordCount = typeof page.meta_word_count === 'boolean' ? page.meta_word_count : !!(postMeta && postMeta.word_count === true)
      - var showReadingTime = typeof page.meta_reading_time === 'boolean' ? page.meta_reading_time : !postMeta || postMeta.reading_time !== false
      - var wordCount = showWordCount ? morii_article_word_count(page) : ''
      - var readingTime = showReadingTime ? morii_reading_time(page) : ''
      .article-meta
        .article-meta__group
          svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' aria-hidden='true')
            rect(x='4' y='6' width='16' height='14' rx='3')
            path(d='M8 4v4m8-4v4M4 11h16')
          .article-meta__items
            if postDateType !== 'updated'
              span #{morii_t("发布于")} #[time(datetime=date_xml(page.date))=date(page.date, 'YYYY-MM-DD')]
            if postDateType !== 'created'
              span #{morii_t("更新于")} #[time(datetime=date_xml(page.updated || page.date))=date(page.updated || page.date, 'YYYY-MM-DD')]
        if wordCount || readingTime
          .article-meta__group
            svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true')
              path(d='M12 6c-2.5-1.7-5.7-2-9-1v14c3-1 6.5-.7 9 1 2.5-1.7 6-2 9-1V5c-3-.9-6.5-.7-9 1zM12 6v14')
            .article-meta__items
              if wordCount
                span= wordCount
              if readingTime
                span= readingTime
  - var sidebarPosition = [page.sidebar_position, theme.article && theme.article.sidebar_position].find(function(position) { return position === 'left' || position === 'right' })
  .wrap.reading-layout(class=sidebarPosition === 'left' ? 'reading-layout--left' : null)
    article.article-card
      .article-toolbar
        if !theme.reading_list || theme.reading_list.enable !== false
          .article-save-tools
            button.reading-preference-button(type='button' data-save-post=url_for(page.path) aria-pressed='false' hidden) #{morii_t("加入稍后阅读 ☆")}
            a.text-link(href=url_for('/reading-list/')) #{morii_t("查看清单 →")}
          p#reading-list-message(role='status' aria-live='polite')
        include includes/reading-settings.pug
      if !page.password && (!theme.article || !theme.article.resume || theme.article.resume.enable !== false)
        .reading-resume#reading-resume(data-updated=date_xml(page.updated || page.date) hidden)
          .reading-resume__copy
            strong #{morii_t("继续上次阅读")}
            p#reading-resume-description
          .reading-resume__actions
            button.reading-preference-button#reading-resume-continue(type='button') #{morii_t("继续阅读 →")}
            button.reading-preference-button#reading-resume-clear(type='button') #{morii_t("清除本篇记录")}
      include includes/article-series.pug
      - var outdatedNotice = morii_outdated_notice(page)
      if outdatedNotice && outdatedNotice.position === 'top'
        include includes/outdated-notice.pug
      if tocOptions.enabled
        details.mobile-toc
          summary #{morii_t("本文目录")}
          include includes/toc.pug
      - var codeStyle = morii_code_style(page)
      - var codeSettings = theme.article && theme.article.code || {}
      - var codeWrap = typeof page.code_word_wrap === 'boolean' ? page.code_word_wrap : codeSettings.word_wrap === true
      - var codeCopy = typeof page.code_copy === 'boolean' ? page.code_copy : codeSettings.copy !== false
      - var codeLanguage = typeof page.code_language === 'boolean' ? page.code_language : codeSettings.language !== false
      - var codeViewer = typeof page.code_viewer === 'boolean' ? page.code_viewer : codeSettings.viewer !== false
      - var codeStartCollapsed = typeof page.code_start_collapsed === 'boolean' ? page.code_start_collapsed : codeSettings.start_collapsed !== false
      .article-body(
        data-code-style=codeStyle.style
        data-code-theme=codeStyle.theme
        data-code-word-wrap=String(codeWrap)
        data-code-copy=codeCopy ? null : 'false'
        data-code-language=codeLanguage ? null : 'false'
        data-code-viewer=codeViewer ? null : 'false'
        data-code-start-collapsed=codeStartCollapsed ? null : 'false'
        data-code-height-limit=codeStyle.heightLimit || null
        data-code-collapse=String(codeSettings.collapse !== false)
        data-code-lines=codeSettings.lines || 18
      )!= morii_article_images(page)
      if outdatedNotice && outdatedNotice.position === 'bottom'
        include includes/outdated-notice.pug
      if page.tags && page.tags.length
        .article-tags
          each tag in page.tags.toArray()
            a(href=url_for(tag.path)) # #{tag.name}
      .article-end
        span ✦
        p #{morii_t("感谢读到这里")}
        include includes/article-reward.pug
      include includes/article-attribution.pug
      .article-tools
        if attribution.editURL
          a.button.service-button.article-edit(href=attribution.editURL target='_blank' rel='noopener noreferrer')= morii_t('编辑此页')
        if !theme.article || !theme.article.share || theme.article.share.enable !== false
          button.button.service-button(type='button' data-share-article aria-haspopup='dialog' aria-controls='article-share-dialog' hidden) #{morii_t("分享文章 ↗")}
        button.button.service-button#copy-article-link(type='button') #{morii_t("复制文章链接 ↗")}
        if !theme.article || !theme.article.print || theme.article.print.enable !== false
          button.button.service-button(type='button' data-preview-print hidden) #{morii_t("打印 / 导出 PDF")}
      if !theme.article || !theme.article.print || theme.article.print.enable !== false
        .print-source
          p #{config.title} · #{config.author}
          p #{morii_t("原文：")}#[a(href=full_url_for((page.path || '').replace(/index\.html$/, '')))=full_url_for((page.path || '').replace(/index\.html$/, ''))]
      include includes/series-navigation.pug
      include includes/article-discovery.pug
      include includes/comments.pug
    aside.reading-aside
      unless tocOptions.simple
        include includes/profile-card.pug
      .reading-aside-sticky
        if tocOptions.enabled
          .side-card.toc-card
            .reading-toc-heading
              h2 #{morii_t("本文目录")}
              if tocOptions.scrollPercent
                span(data-reading-percent aria-hidden='true') 0%
            nav(aria-label=morii_t("文章章节"))
              include includes/toc.pug
        unless tocOptions.simple
          include includes/clock.pug
