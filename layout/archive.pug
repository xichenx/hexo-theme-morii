extends includes/layout.pug
include includes/mixins.pug

block content
  .wrap.listing-page
    .page-intro
      span.section-kicker= is_category() ? 'CATEGORY' : is_tag() ? 'TAG' : 'ALL STORIES'
      h1= morii_page_title(page)
      p= is_category() || is_tag() ? '这个主题下的所有文章。' : '所有思考与实践，都在这里留下时间的刻度。'
    .content-grid
      section.posts-column
        include includes/category-nav.pug
        if page.posts && page.posts.length
          if is_archive()
            .archive-groups
              each group in morii_archive_groups(page.posts)
                section.archive-year.panel
                  .archive-year__heading
                    h2= group.year
                    span 本页 #{group.entries.length} 篇
                  each post in group.entries
                    a.archive-entry(href=url_for(post.path))
                      time(datetime=date_xml(post.date))= date(post.date, 'MM.DD')
                      strong= post.title
                      if post.password
                        small 加密
                      span(aria-hidden='true') ↗
          else
            .post-grid
              each post in page.posts.toArray()
                +postCard(post, false)
        else
          p.empty-state 这里还没有文章，去其他分类看看吧。
        include includes/pagination.pug
      include includes/sidebar.pug
