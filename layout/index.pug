extends includes/layout.pug
include includes/mixins.pug

mixin homeJournal()
  .hero-mini.hero-mini--quote
    span.mini-label #{morii_t("✦ 随手记")}
    strong= theme.hero && theme.hero.note || morii_t("把热爱写进日常，把好奇带向远方。")
    if morii_has_page('/essay/')
      a(href=url_for('/essay/')) #{morii_t("看看即刻")} #[span →]
    else
      a(href=url_for('/archives/')) #{morii_t("继续探索")} #[span →]
  .hero-mini.hero-mini--stats
    span.mini-label #{morii_t("◉ 博客手账")}
    .stats-grid
      div #[strong=site.posts.length] #[span #{morii_t("篇文章")}]
      div #[strong=site.categories.length] #[span #{morii_t("个分类")}]

block content
  - var firstPage = !page.current || page.current === 1
  if firstPage
    - var themePromo = morii_theme_promo()
    - var hero = morii_home_hero(siteIdentity)
    section.hero.wrap
      .hero__main
        if hero.eyebrow
          .eyebrow #[span.eyebrow__dot] #{hero.eyebrow}
        h1
          = siteIdentity.title[0]
          if siteIdentity.title[1]
            br
            em= siteIdentity.title[1]
        if hero.intro
          p= hero.intro
        if hero.primary || hero.secondary
          .hero__actions
            if hero.primary
              a.button.button--primary(href=hero.primary.href) #{hero.primary.label} #[span(aria-hidden='true') →]
            if hero.secondary
              a.button.button--ghost(href=hero.secondary.href)= hero.secondary.label
        if hero.signature
          .hero__signature= hero.signature
      if themePromo
        section.theme-promo(aria-labelledby='theme-promo-title')
          .theme-promo__wordmark
            h2#theme-promo-title
              img(src=url_for('/icons/brand/morii-promo-wordmark.webp') alt='Morii' width='800' height='400' decoding='async')
            if !theme.motion || theme.motion.enable !== false
              include includes/promo-ink.pug
          .theme-promo__footer
            span #{morii_t("开源 Hexo 主题")}
            if themePromo.docs || themePromo.source
              .theme-promo__actions
                if themePromo.source
                  a.button(class=themePromo.docs ? 'theme-promo__secondary' : 'theme-promo__cover' href=themePromo.source) #{morii_t("GitHub 源码")} #[span(aria-hidden='true') ↗]
                if themePromo.docs
                  a.button.theme-promo__cover(href=themePromo.docs) #{morii_t("安装指南")} #[span(aria-hidden='true') ↗]
        if themePromo.journalBelow
          .hero__journal
            +homeJournal()
      else
        .hero__side
          +homeJournal()
    if theme.featured && theme.featured.length
      section.wrap.section-block
        .section-heading
          div
            span.section-kicker EXPLORE
            h2 #{morii_t("从这里开始")}
          p #{morii_t("选择感兴趣的方向，慢慢逛。")}
        .feature-grid
          each item in theme.featured
            a.feature-card(href=url_for(item.path) class='feature-card--' + item.tone)
              - var iconName = morii_icon(item.icon)
              span.feature-card__icon(class=iconName ? 'ui-icon ui-icon--' + iconName : '' aria-hidden='true')
                if !iconName
                  = item.icon
              span.feature-card__arrow ↗
              strong= item.title
              small= item.description
    include includes/selected-posts.pug
    include includes/home-discovery.pug
    include includes/github-calendar.pug
  else
    h1.sr-only #{morii_t("文章 · 第 {0} 页", page.current)}
  .wrap.content-grid#latest
    section.posts-column
      .section-heading.section-heading--posts
        div
          span.section-kicker LATEST STORIES
          h2= firstPage ? morii_t("最新文章") : morii_t("继续阅读")
        a.text-link(href=url_for('/archives/')) #{morii_t("全部文章 →")}
      include includes/category-nav.pug
      if page.posts && page.posts.length
        .post-grid
          each post, index in page.posts.toArray()
            +postCard(post, morii_layout('home') === 'featured' && page.posts.length % 2 === 1 && index === 0, !firstPage && index < 2)
      else
        p.empty-state #{morii_t("还没有文章，稍后再来看看。")}
      include includes/pagination.pug
    include includes/sidebar.pug
