{
  "name": "hexo-theme-morii",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "A rich card Hexo theme with an immersive music room.",
  "repository": {
    "type": "git",
    "url": "https://github.com/xichenx/hexo-theme-morii.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "check": "node tools/check.cjs",
