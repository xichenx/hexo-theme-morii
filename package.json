{
  "name": "hexo-theme-morii",
  "version": "1.0.1",
  "description": "A rich card Hexo theme with music and cinema pages.",
  "license": "MIT",
  "keywords": [
    "hexo",
    "hexo-theme",
    "theme",
    "blog",
    "morii"
  ],
  "homepage": "https://github.com/xichenx/hexo-theme-morii#readme",
  "bugs": {
    "url": "https://github.com/xichenx/hexo-theme-morii/issues"
  },
  "files": [
    "_config.yml",
    "layout/",
    "scripts/",
    "source/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xichenx/hexo-theme-morii.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "check": "node tools/check.cjs",
    "test": "npm run check && node --test tests/*.test.cjs",
    "build:demo": "node tools/demo.cjs",
    "audit:performance": "node tools/performance.cjs",
    "release:check": "node tools/release.cjs check",
    "package:theme": "node tools/release.cjs pack",
    "docs:dev": "vitepress dev site",
    "docs:build": "vitepress build site",
    "docs:preview": "vitepress preview site"
  },
  "dependencies": {
    "hexo-util": "^3.3.0"
  },
  "peerDependencies": {
    "hexo": ">=8.0.0",
    "hexo-renderer-pug": ">=3.0.0"
  },
  "devDependencies": {
    "hexo": "8.1.2",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-marked": "7.0.1",
    "hexo-renderer-pug": "3.0.0",
    "js-yaml": "4.1.1",
    "jsdom": "25.0.1",
    "vitepress": "^1.6.4"
  }
}
